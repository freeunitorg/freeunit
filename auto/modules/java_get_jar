# NXT_JAR_NAME=
# NXT_JAR_VERSION=
# NXT_JAR_NAMESPACE=
# NXT_JAR_REPO=http://central.maven.org/maven2/
# NXT_JAR_LOCAL_REPO=$HOME/.m2/repository/

NXT_JAR_FILE=${NXT_JAR_NAME}-${NXT_JAR_VERSION}.jar
NXT_JAR_LOCAL_DIR="${NXT_JAR_LOCAL_REPO}${NXT_JAR_NAMESPACE}${NXT_JAR_NAME}/${NXT_JAR_VERSION}"
NXT_JAR_LOCAL="${NXT_JAR_LOCAL_DIR}/${NXT_JAR_FILE}"
NXT_JAR_LOCAL_TMP="${NXT_JAR_LOCAL_DIR}/.${NXT_JAR_FILE}.$$"
NXT_JAR_URL=${NXT_JAR_REPO}${NXT_JAR_NAMESPACE}${NXT_JAR_NAME}/${NXT_JAR_VERSION}/${NXT_JAR_FILE}

NXT_JAR_CHK_FILE="$NXT_BUILD_DIR/$NXT_JAR_FILE"
. auto/modules/java_chk_sha512

if [ ! -f "$NXT_BUILD_DIR/$NXT_JAR_FILE" ]; then
    NXT_JAR_CHK_FILE=$NXT_JAR_LOCAL
    . auto/modules/java_chk_sha512

    if [ ! -f "${NXT_JAR_LOCAL}" ]; then
        $echo "getting remote $NXT_JAR_FILE ... "
        $echo "getting remote $NXT_JAR_FILE ..." >> $NXT_AUTOCONF_ERR

        mkdir -p "${NXT_JAR_LOCAL_DIR}"

        # The observed CI failure is a COMPLETE transfer of the wrong bytes:
        # a "100.0%" progress bar in 0.07s for a 280 KB jar, then a checksum
        # mismatch -- an error page or a poisoned cache, not a truncated
        # download.  curl's own --retry does not cover that, since as far as
        # curl is concerned the transfer succeeded, so the retry has to span
        # the verification too.  --fail keeps an error page from being written
        # out as if it were the jar, and --location follows a redirect.
        NXT_JAR_TRY=1
        NXT_JAR_FAIL=download

        while [ $NXT_JAR_TRY -le 3 ]; do

            if curl --fail --location --retry 2 --retry-delay 2 \
                    --progress-bar "$NXT_JAR_URL" -o "$NXT_JAR_LOCAL_TMP"
            then
                NXT_JAR_CHK_FILE=$NXT_JAR_LOCAL_TMP
                . auto/modules/java_chk_sha512

                # java_chk_sha512 deletes the file it rejects, so the file
                # surviving means the checksum matched.
                if [ -f "$NXT_JAR_LOCAL_TMP" ]; then
                    break
                fi

                NXT_JAR_FAIL=checksum

                $echo "retrying $NXT_JAR_FILE: checksum did not match"
            else
                rm -f "$NXT_JAR_LOCAL_TMP"

                NXT_JAR_FAIL=download

                $echo "retrying $NXT_JAR_FILE: download failed"
            fi

            NXT_JAR_TRY=$((NXT_JAR_TRY + 1))
        done

        # Every attempt was rejected.  Say why, rather than letting the mv
        # below fail with a "cannot stat" that hides the cause, and keep the
        # two causes apart: a download that never arrived is a different
        # problem from bytes that arrived and did not verify.
        if [ ! -f "$NXT_JAR_LOCAL_TMP" ] && [ "$NXT_JAR_FAIL" = "download" ]
        then
            $echo
            $echo $0: error: failed to download "$NXT_JAR_URL".
            $echo
            $echo "error: failed to download $NXT_JAR_URL" >> $NXT_AUTOCONF_ERR
            exit 1
        fi

        if [ ! -f "$NXT_JAR_LOCAL_TMP" ]; then
            $echo
            $echo $0: error: SHA512 mismatch for "$NXT_JAR_FILE".
            $echo
            $echo "  downloaded from: $NXT_JAR_URL"
            $echo "  expected SHA512: $NXT_JAR_SHA512"
            $echo
            $echo "  The pinned checksum is in auto/modules/java_jar.sha512."
            $echo "  A mismatch means the download was truncated or proxied,"
            $echo "  or the artifact itself changed."
            $echo
            $echo "error: SHA512 mismatch for $NXT_JAR_FILE" \
                  >> $NXT_AUTOCONF_ERR
            exit 1
        fi

        mv "$NXT_JAR_LOCAL_TMP" "$NXT_JAR_LOCAL"
    else
        $echo "getting local $NXT_JAR_FILE"
        $echo "getting local $NXT_JAR_FILE ..." >> $NXT_AUTOCONF_ERR
    fi

    cp "$NXT_JAR_LOCAL" "$NXT_BUILD_DIR/$NXT_JAR_FILE"
fi

NXT_JAVA_BUILD_CP="${NXT_JAVA_BUILD_CP}:$NXT_BUILD_DIR/$NXT_JAR_FILE"
NXT_JAVA_INSTALL_JARS="$NXT_JAVA_INSTALL_JARS $NXT_BUILD_DIR/$NXT_JAR_FILE"
NXT_JAVA_UNINSTALL_JARS="$NXT_JAVA_UNINSTALL_JARS \$(DESTDIR)$NXT_JARS/$NXT_JAR_FILE"

$echo "    \"$NXT_JAR_FILE\"," >> $NXT_JAVA_JARS
