# GCC atomic builtins.  src/nxt_atomic.h needs the __sync_* intrinsics of
# GCC 4.1.  A compiler without them cannot build Unit.

nxt_feature="GCC builtin atomic operations"
nxt_feature_name=NXT_HAVE_GCC_ATOMIC
nxt_feature_run=yes
nxt_feature_incs=
nxt_feature_libs=
nxt_feature_test="#include <stdint.h>

                  int main(void) {
                      volatile uintptr_t  n = 0;

                      if (!__sync_bool_compare_and_swap(&n, 0, 3))
                          return 1;
                      if (__sync_fetch_and_add(&n, 1) != 3)
                          return 1;
                      if (__sync_lock_test_and_set(&n, 5) != 4)
                          return 1;
                      if (n != 5)
                          return 1;
                      if (__sync_or_and_fetch(&n, 2) != 7)
                          return 1;
                      if (__sync_and_and_fetch(&n, 5) != 5)
                          return 1;
                      __sync_lock_release(&n);
                      if (n != 0)
                          return 1;
                      return 0;
                  }"
. auto/feature


if [ $nxt_found = no ]; then
    $echo
    $echo $0: error: no atomic operations found.
    $echo
    exit 1;
fi


# The __atomic_load_n and __atomic_store_n builtins of GCC 4.7 give the
# ordered loads and stores in src/nxt_atomic.h.  An older compiler, such as
# GCC 4.4 of RHEL 6, does not have them.  Then src/nxt_atomic.h uses volatile
# accesses and __sync_synchronize() instead.  Thus this probe is not fatal.

nxt_feature="GCC builtin ordered atomic loads and stores"
nxt_feature_name=NXT_HAVE_GCC_ATOMIC_ORDERED
nxt_feature_run=yes
nxt_feature_incs=
nxt_feature_libs=
nxt_feature_test="#include <stdint.h>

                  int main(void) {
                      volatile uintptr_t  n = 0;

                      if (__atomic_load_n(&n, __ATOMIC_RELAXED) != 0)
                          return 1;
                      __atomic_store_n(&n, 1, __ATOMIC_RELAXED);
                      if (__atomic_load_n(&n, __ATOMIC_ACQUIRE) != 1)
                          return 1;
                      __atomic_store_n(&n, 2, __ATOMIC_RELEASE);
                      if (n != 2)
                          return 1;
                      return 0;
                  }"
. auto/feature
