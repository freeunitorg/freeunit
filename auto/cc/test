$echo checking for C compiler: $CC
cat << END >> $NXT_AUTOCONF_ERR
----------------------------------------
checking for C compiler: $CC
END


# Allow error exit status.
set +e

if [ -z `which $CC` ]; then
    $echo
    $echo $0: error: $CC not found.
    $echo
    exit 1;
fi


if `/bin/sh -c "($CC -v)" 2>&1 | grep "gcc version" >> $NXT_AUTOCONF_ERR 2>&1`
then
    NXT_CC_NAME=gcc
    $echo " + using GNU C compiler"
    NXT_CC_VERSION=`/bin/sh -c "($CC -v)" 2>&1 | grep "gcc version" 2>&1`
    $echo " + $NXT_CC_VERSION"

else
if `/bin/sh -c "($CC -v)" 2>&1 | grep "clang version" >> $NXT_AUTOCONF_ERR 2>&1`
then
    NXT_CC_NAME=clang
    $echo " + using Clang C compiler"
    NXT_CC_VERSION=`/bin/sh -c "($CC -v)" 2>&1 | grep "clang version" 2>&1`
    $echo " + $NXT_CC_VERSION"

else
if `/bin/sh -c "($CC -v)" 2>&1 \
                 | grep "Apple LLVM version" >> $NXT_AUTOCONF_ERR 2>&1`
then
    NXT_CC_NAME=clang
    $echo " + using Clang C compiler"
    NXT_CC_VERSION=`/bin/sh -c "($CC -v)" 2>&1 | grep "Apple LLVM version" 2>&1`
    $echo " + $NXT_CC_VERSION"

else
    NXT_CC_NAME=cc
    NXT_CC_VERSION=cc

fi # Apple LLVM clang
fi # clang
fi # gcc


# Use the newest C dialect that the compiler accepts.  Current GCC and
# Clang accept -std=gnu11.  GCC 4.6 accepts only the draft name -std=gnu1x.
# GCC 4.4 and 4.5 accept neither, and get -std=gnu99.  Each later probe and
# the build use NXT_CFLAGS.  A flag that the compiler rejects fails all of
# them.  Thus each candidate is probed before it goes into NXT_CFLAGS.

nxt_cc_try_std()
{
    echo 'int main(void) { return 0; }' > $NXT_AUTOTEST.c

    for nxt_std in -std=gnu11 -std=gnu1x -std=gnu99; do
        if /bin/sh -c "($CC $NXT_CFLAGS $nxt_std $NXT_CC_OPT $CFLAGS \
                        -Werror -c -o $NXT_AUTOTEST.o $NXT_AUTOTEST.c)" \
            >> $NXT_AUTOCONF_ERR 2>&1
        then
            NXT_CFLAGS="$NXT_CFLAGS $nxt_std"
            $echo " + using $nxt_std"
            break
        fi
    done

    rm -f $NXT_AUTOTEST.c $NXT_AUTOTEST.o
}


case $NXT_CC_NAME in

    gcc)
        nxt_have=NXT_GCC . auto/have

        NXT_CFLAGS="$NXT_CFLAGS -pipe"
        NXT_CFLAGS="$NXT_CFLAGS -fPIC"

        # Do not export symbols except explicitly marked with NXT_EXPORT.
        NXT_CFLAGS="$NXT_CFLAGS -fvisibility=hidden"

        NXT_CFLAGS="$NXT_CFLAGS -fno-strict-overflow"

        NXT_CFLAGS="$NXT_CFLAGS -funsigned-char"

        nxt_cc_try_std

        NXT_CFLAGS="$NXT_CFLAGS -O"
        NXT_CFLAGS="$NXT_CFLAGS -Wall -Wextra"

        #NXT_CFLAGS="$NXT_CFLAGS -Wunused-result"
        NXT_CFLAGS="$NXT_CFLAGS -Wno-unused-parameter"
        #NXT_CFLAGS="$NXT_CFLAGS -Wshorten-64-to-32"
        NXT_CFLAGS="$NXT_CFLAGS -Wwrite-strings"

        # -O2 enables -fstrict-aliasing and -fstrict-overflow.
        #NXT_CFLAGS="$NXT_CFLAGS -O2"
        NXT_CFLAGS="$NXT_CFLAGS -fno-strict-aliasing"

        #NXT_CFLAGS="$NXT_CFLAGS -fomit-frame-pointer"
        #NXT_CFLAGS="$NXT_CFLAGS -momit-leaf-frame-pointer"

        # While -Wstrict-overflow is supported by GCC 4.2+,
        # at level 3 and above it is prone to give false
        # positives.
        #NXT_CFLAGS="$NXT_CFLAGS -Wstrict-overflow=5"

        NXT_CFLAGS="$NXT_CFLAGS -Wmissing-prototypes"

        # Stop on warning.
        NXT_CFLAGS="$NXT_CFLAGS -Werror"

        # Debug.
        NXT_CFLAGS="$NXT_CFLAGS -g"
    ;;

    clang)
        nxt_have=NXT_CLANG . auto/have

        NXT_CFLAGS="$NXT_CFLAGS -pipe"
        NXT_CFLAGS="$NXT_CFLAGS -fPIC"

        # Do not export symbols except explicitly marked with NXT_EXPORT.
        NXT_CFLAGS="$NXT_CFLAGS -fvisibility=hidden"

        NXT_CFLAGS="$NXT_CFLAGS -fno-strict-overflow"

        NXT_CFLAGS="$NXT_CFLAGS -funsigned-char"

        nxt_cc_try_std

        NXT_CFLAGS="$NXT_CFLAGS -O"
        NXT_CFLAGS="$NXT_CFLAGS -Wall -Wextra"

        #NXT_CFLAGS="$NXT_CFLAGS -Wunused-result"
        NXT_CFLAGS="$NXT_CFLAGS -Wno-unused-parameter"
        #NXT_CFLAGS="$NXT_CFLAGS -Wshorten-64-to-32"
        NXT_CFLAGS="$NXT_CFLAGS -Wwrite-strings"
        #NXT_CFLAGS="$NXT_CFLAGS -O2"
        # strict-aliasing is always enabled by default in clang
        NXT_CFLAGS="$NXT_CFLAGS -fno-strict-aliasing"

        #NXT_CFLAGS="$NXT_CFLAGS -fomit-frame-pointer"
        NXT_CFLAGS="$NXT_CFLAGS -Wstrict-overflow=5"

        NXT_CFLAGS="$NXT_CFLAGS -Wmissing-prototypes"

        # Stop on warning.
        NXT_CFLAGS="$NXT_CFLAGS -Werror"

        # Debug.

        if [ "$NXT_SYSTEM_PLATFORM" != "powerpc" ]; then
            # "-g" flag causes the "unknown pseudo-op: `.cfi_sections'"
            # error on PowerPC Clang.
            NXT_CFLAGS="$NXT_CFLAGS -g"
        fi
    ;;

    *)
    ;;

esac


# GCC before 4.7 gives some -Wextra warnings for code that newer GCC and
# Clang accept.  For each such warning, a probe compiles a short example
# with the warning flags of the build.  When the example fails only because
# of the warning, the build turns off that one warning.

nxt_cc_try_quiet()
{
    nxt_warning=$1

    cat << END > $NXT_AUTOTEST.c
$2
int main(void) { return 0; }
END

    if /bin/sh -c "($CC $NXT_CFLAGS $NXT_CC_OPT $CFLAGS \
                    -c -o $NXT_AUTOTEST.o $NXT_AUTOTEST.c)" \
        >> $NXT_AUTOCONF_ERR 2>&1
    then
        :

    elif /bin/sh -c "($CC $NXT_CFLAGS -Wno-$nxt_warning $NXT_CC_OPT \
                      $CFLAGS -c -o $NXT_AUTOTEST.o $NXT_AUTOTEST.c)" \
        >> $NXT_AUTOCONF_ERR 2>&1
    then
        NXT_CFLAGS="$NXT_CFLAGS -Wno-$nxt_warning"
        $echo " + using -Wno-$nxt_warning"
    fi

    rm -f $NXT_AUTOTEST.c $NXT_AUTOTEST.o
}


if [ $NXT_CC_NAME = gcc ]; then

    # GCC 4.4 warns about the initializers "{}" and "{ 0 }" of a structure,
    # and about a designated initializer of a nested member.

    nxt_cc_try_quiet missing-field-initializers \
'struct nxt_autotest_s { int a; int b; };
int nxt_autotest(void);
int nxt_autotest(void) { struct nxt_autotest_s s = {}; return s.a + s.b; }'

fi


# Keep the build directory out of the debug info and of __FILE__.  The
# probe runs with the flags that are already set, as the real build does.
# -ffile-prefix-map needs GCC 8 or Clang 10.  Older compilers get
# -fdebug-prefix-map, and a compiler with neither gets no flag.

nxt_prefix_dir=`pwd`

# A packager who already maps paths in --cc-opt or CFLAGS keeps that
# mapping; adding a second one would only duplicate the flag in CFLAGS.

case " $NXT_CC_OPT $CFLAGS " in
    *" -ffile-prefix-map="* | *" -fdebug-prefix-map="*)
        $echo " + path map already set in --cc-opt or CFLAGS"
        nxt_prefix_dir=
    ;;
esac

case "$nxt_prefix_dir" in
    "")
    ;;

    *[!A-Za-z0-9_./+@%:,-]*)
        # Spaces and shell characters would break the Makefile.
    ;;

    *)
        echo 'int main(void) { return 0; }' > $NXT_AUTOTEST.c

        for nxt_prefix_flag in -ffile-prefix-map -fdebug-prefix-map; do
            nxt_prefix_map="$nxt_prefix_flag=$nxt_prefix_dir=."

            if /bin/sh -c "($CC $NXT_CFLAGS $nxt_prefix_map $NXT_CC_OPT \
                            $CFLAGS -Werror -c -o $NXT_AUTOTEST.o \
                            $NXT_AUTOTEST.c)" >> $NXT_AUTOCONF_ERR 2>&1
            then
                NXT_CFLAGS="$NXT_CFLAGS $nxt_prefix_map"
                $echo " + using $nxt_prefix_flag"
                break
            fi
        done

        rm -f $NXT_AUTOTEST.c $NXT_AUTOTEST.o
    ;;
esac

# Stop on error exit status again.
set -e
