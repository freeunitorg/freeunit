if [ $nxt_found = no ]; then

    # A libc without the wrapper, such as musl, may still have the number.

    nxt_feature="close_range() syscall"
    nxt_feature_name=NXT_HAVE_SYS_CLOSE_RANGE
    nxt_feature_test="#include <unistd.h>
                      #include <sys/syscall.h>

                      int main(void) {
                          return syscall(SYS_close_range, 3, ~0U, 0);
                      }"
    . auto/feature
fi


