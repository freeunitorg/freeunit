# Linux 2.6, FreeBSD 8.2, 9.1, Solaris 11.

nxt_feature="posix_fadvise()"
nxt_feature_name=NXT_HAVE_POSIX_FADVISE
nxt_feature_run=
nxt_feature_incs=
nxt_feature_libs=
nxt_feature_test="#include <fcntl.h>

                  int main(void) {
                      (void) posix_fadvise(0, 0, 0, POSIX_FADV_WILLNEED);
                      return 0;
                  }"
. auto/feature


